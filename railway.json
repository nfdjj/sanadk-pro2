{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "npm run build"
  },
  "deploy": {
    "preDeployCommand": [
      "php artisan migrate --force",
      "php artisan db:seed --class=HeroSeeder --force",
      "php artisan db:seed --class=ServiceSeeder --force",
      "php artisan db:seed --class=WhyUsSeeder --force",
      "php artisan db:seed --class=WhoUsSeeder --force",
      "php artisan db:seed --class=RailwayAdminSeeder --force"
    ],
    "healthcheckPath": "/up",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
